# Copy to .env. Expo bundles every EXPO_PUBLIC_* value into the app, so never put a secret here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional: crash reporting stays off when this is empty
EXPO_PUBLIC_SENTRY_DSN=

# Android maps are blank without a Google Maps SDK key. Restrict the key to your app in the Google Cloud console.
GOOGLE_MAPS_API_KEY=
